a = int(input("Ingrese la variable a: "))
b = int(input("Ingrese la variable b: "))

print("\nRegistro:")
print(f"a = {a}, Dirección de memoria = {id(a)}")
print(f"b = {b}, Dirección de memoria = {id(b)}")

a, b = b, a

print("\nIntercambio (swap):")
print(f"a = {a} y su Dirección de memoria = {id(a)}")
print(f"b = {b} y su Dirección de memoria = {id(b)}")
