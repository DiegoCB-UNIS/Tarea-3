#include <stdint.h>

#define PERIPHERAL_BASE_ADDRESS   0x40000000U
#define AHB_BASE_ADDRESS         (PERIPHERAL_BASE_ADDRESS + 0x00020000U)

#define RCC_BASE_ADDRESS         (AHB_BASE_ADDRESS + 0x00001000U)
#define RCC_IOPENR_ADDRESS      (RCC_BASE_ADDRESS + 0x0000002CU)
#define RCC_IOPENR              (*(volatile uint32_t*)RCC_IOPENR_ADDRESS)

#define IOPORT_ADDRESS          (PERIPHERAL_BASE_ADDRESS + 0x00100000U)

#define GPIOA_BASE_ADDRESS      (IOPORT_ADDRESS + 0x00000000U)
#define GPIOA_MODER_REG        (*(volatile uint32_t*)(GPIOA_BASE_ADDRESS + 0x00000000U))
#define GPIOA_ODR_REG          (*(volatile uint32_t*)(GPIOA_BASE_ADDRESS + 0x00000014U))

#define GPIOC_BASE_ADDRESS      (IOPORT_ADDRESS + 0x00000800U)
#define GPIOC_MODER_REG        (*(volatile uint32_t*)(GPIOC_BASE_ADDRESS + 0x00000000U))
#define GPIOC_IDR_REG          (*(volatile uint32_t*)(GPIOC_BASE_ADDRESS + 0x00000010U))

int main(void)
{
    RCC_IOPENR |= (1 << 0); 
    RCC_IOPENR |= (1 << 2);

    GPIOA_MODER_REG &= ~(3U << (5 * 2)); 
    GPIOA_MODER_REG |=  (1U << (5 * 2)); 

    GPIOC_MODER_REG &= ~(3U << (13 * 2)); 

    while (1)
    {
        if ((GPIOC_IDR_REG & (1 << 13)) == 0)
            GPIOA_ODR_REG |= (1 << 5);
        }
        else
        {
            GPIOA_ODR_REG &= ~(1 << 5);
        }
    }
}
